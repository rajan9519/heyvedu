# Copy to Config/release.env (gitignored), then replace these placeholders.
# This is a shell file sourced by scripts/release.sh. Never put passwords here.
DEVELOPMENT_TEAM="YOUR_TEAM_ID"
SIGNING_IDENTITY="Developer ID Application: YOUR_NAME (YOUR_TEAM_ID)"
NOTARY_PROFILE="heyvedu-notary"
# Optional: how long to wait for Apple per submission (default 2h; first ones can be slow).
# NOTARY_TIMEOUT="2h"

# The version (YY.MM.DDNN) is chosen by the script from the published appcast.
